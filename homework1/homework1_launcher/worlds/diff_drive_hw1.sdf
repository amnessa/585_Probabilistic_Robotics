<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="demo">
    <!-- When we declare sytem here this automatically overrides the default so everything else gets disabled -->
  <!-- Ensure the physics system is loaded -->
  <plugin filename="ignition-gazebo-physics-system"
          name="ignition::gazebo::systems::Physics">
  </plugin>
  <!-- Ensure the sensors system is loaded -->
  <plugin filename="libignition-gazebo-sensors-system.so"
          name="ignition::gazebo::systems::Sensors">
    <render_engine>ogre2</render_engine>
  </plugin>

  <plugin filename="libignition-gazebo-imu-system.so"
        name="ignition::gazebo::systems::Imu">
  </plugin>

  <plugin filename="ignition-gazebo-scene-broadcaster-system"
          name="ignition::gazebo::systems::SceneBroadcaster"/>
  <plugin filename="ignition-gazebo-user-commands-system"
          name="ignition::gazebo::systems::UserCommands"/>

    <gravity>0 0 -9.8</gravity>

    <!-- Sun -->
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.5 0.5 -1</direction>
    </light>

    <!-- Flat ground -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Vehicles -->
    <include>
      <uri>model://vehicle_blue</uri>
      <name>vehicle_blue</name>
      <!-- lift Z so wheels clear ground -->
      <pose>0 2 0.35 0 0 0</pose>
    </include>

    <include>
      <uri>model://vehicle_green</uri>
      <name>vehicle_green</name>
      <!-- lift Z so wheels clear ground -->
      <pose>0 -2 0.35 0 0 0</pose>
    </include>

  </world>
</sdf>
<!-- BELOW THIS LINE IT IS EXAMPLE 4 WALLS AND A DOOR WITH HINGE ENVIRONMENT add it under <world> -->


      <!-- Room walls (10x10m, 1.5m high, 0.2m thick) -->
      <!-- North wall split to leave a 1.0m door gap at x=0 -->
      <model name="wall_north_left">
        <static>true</static>
        <pose>-2.75 5 0.75 0 0 0</pose>
        <link name="link">
        <collision name="collision">
          <geometry><box><size>4.5 0.2 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.5 0.2 1.5</size></box></geometry>
          <material><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
        </link>
      </model>

      <model name="wall_north_right">
        <static>true</static>
        <pose>2.75 5 0.75 0 0 0</pose>
        <link name="link">
        <collision name="collision">
          <geometry><box><size>4.5 0.2 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.5 0.2 1.5</size></box></geometry>
          <material><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
        </link>
      </model>

      <model name="wall_south">
        <static>true</static>
        <pose>0 -5 0.75 0 0 0</pose>
        <link name="link">
        <collision name="collision">
          <geometry><box><size>10 0.2 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10 0.2 1.5</size></box></geometry>
          <material><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
        </link>
      </model>

      <model name="wall_east">
        <static>true</static>
        <pose>5 0 0.75 0 0 0</pose>
        <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 10 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 10 1.5</size></box></geometry>
          <material><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
        </link>
      </model>

      <model name="wall_west">
        <static>true</static>
        <pose>-5 0 0.75 0 0 0</pose>
        <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 10 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 10 1.5</size></box></geometry>
          <material><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
        </link>
      </model>

      <!-- Hinged door in the north wall (1.0m wide, 1.5m tall, 0.05m thick) -->
      <model name="swing_door">
        <!-- Place hinge on the north wall line at y=5, z at mid-height -->
        <pose>0 5 0.75 0 0 0</pose>
        <self_collide>false</self_collide>

        <!-- Door frame/jamb (fixed in place) -->
        <link name="frame">
        <inertial><mass>10</mass>
          <inertia>
          <ixx>1</ixx><iyy>1</iyy><izz>1</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.1 0.2 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 0.2 1.5</size></box></geometry>
          <material><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        </link>

        <!-- Door leaf: origin at hinge; geometry offset 0.5m along +X -->
        <link name="leaf">
        <inertial><mass>5</mass>
          <inertia>
          <ixx>1</ixx><iyy>1</iyy><izz>0.5</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <pose>0.5 0 0 0 0 0</pose>
          <geometry><box><size>1.0 0.05 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <pose>0.5 0 0 0 0 0</pose>
          <geometry><box><size>1.0 0.05 1.5</size></box></geometry>
          <material><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
        </link>

        <!-- Revolute hinge around Z (vertical). Angle 0 = closed (in wall plane) -->
        <joint name="hinge" type="revolute">
        <parent>frame</parent>
        <child>leaf</child>
        <pose>0 0 0 0 0 0</pose>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
          <lower>-1.57</lower>   <!-- ~ -90 deg (opens inward) -->
          <upper>1.57</upper>    <!-- ~  90 deg -->
          </limit>
          <dynamics>
          <damping>0.5</damping>
          </dynamics>
        </axis>
        </joint>
      </model>

